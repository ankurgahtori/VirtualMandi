{
  "name": "@virtual-mandi/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "start": "adb reverse tcp:3000 tcp:3000 >/dev/null 2>&1 || true; expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "install:android": "adb reverse tcp:3000 tcp:3000 && expo run:android --no-bundler",
    "install:ios": "expo run:ios --no-bundler",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch",
    "lint": "eslint src App.tsx",
    "typecheck": "tsc --noEmit",
    "test": "EXPO_PUBLIC_API_BASE_URL=http://localhost:3000 tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.9",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@virtual-mandi/shared": "workspace:*",
    "expo": "^52.0.36",
    "expo-secure-store": "~14.0.1",
    "react": "^18.3.1",
    "react-native": "^0.76.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "expo-doctor": "^1.12.0",
    "tsx": "^4.19.2"
  }
}
