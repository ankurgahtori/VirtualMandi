# Local development defaults. Copy to .env.local; never commit real values.
POSTGRES_DB=virtual_mandi
POSTGRES_USER=virtual_mandi
POSTGRES_PASSWORD=virtual_mandi_local
POSTGRES_PORT=5432

DATABASE_URL=postgresql://virtual_mandi:virtual_mandi_local@localhost:5432/virtual_mandi?schema=public

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=virtual-mandi-local
S3_ENDPOINT=http://localhost:4566
LOCALSTACK_EDGE_PORT=4566
