{
  "name": "virtual-mandi",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d postgres localstack",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "prisma:validate": "pnpm --filter @virtual-mandi/database prisma:validate",
    "prisma:generate": "pnpm --filter @virtual-mandi/database prisma:generate",
    "db:migrate": "pnpm --filter @virtual-mandi/database db:migrate",
    "db:seed": "pnpm --filter @virtual-mandi/database db:seed",
    "db:reset": "pnpm --filter @virtual-mandi/database db:reset",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "simple-git-hooks": "^2.11.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm format:check && pnpm lint && pnpm typecheck"
  }
}
